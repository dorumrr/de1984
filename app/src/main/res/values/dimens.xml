<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Override Material3 bottom navigation spacing -->
    <dimen name="m3_bottom_nav_item_with_label_padding_vertical">0dp</dimen>
    <dimen name="mtrl_navigation_bar_item_default_margin">0dp</dimen>
    <dimen name="design_bottom_navigation_margin">0dp</dimen>
    <dimen name="design_bottom_navigation_active_item_max_width">168dp</dimen>
    <dimen name="design_bottom_navigation_active_item_min_width">96dp</dimen>
    <dimen name="m3_navigation_item_padding">0dp</dimen>

    <!-- The search box reserves this much of its right edge so typed text does not run under the
         package counter drawn on top of it. They live here, not inline in two layouts. -->
    <dimen name="search_counter_reserved">100dp</dimen>
    <!-- Breathing space kept between the search hint and the counter. -->
    <dimen name="search_counter_gap">12dp</dimen>

    <!-- The counter keeps clear of the box's own clear (X) icon strip, 40dp, plus one strip per
         button beside the box (sort; export on Packages, #96); the box stops short by the buttons. -->
    <dimen name="search_action_button_size">40dp</dimen>
    <dimen name="search_actions_two_buttons">80dp</dimen>
    <dimen name="search_counter_padding_end_one_button">80dp</dimen>
    <dimen name="search_counter_padding_end_two_buttons">120dp</dimen>
</resources>

